rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/readingProgress/{readingId} {
      allow read, write: if request.auth != null && request.auth.uid == userId
        && readingId.matches('2023-[0-1][0-9]-[0-3][0-9]')
        && (resource == null || resource.data.keys().hasOnly(['done', 'updatedAt']))
        && (request.method == 'delete' || (request.resource.data.keys().hasOnly(['done', 'updatedAt'])
          && request.resource.data.done is bool));
    }
  }
}
